# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose this to the browser. API routes only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to "true" on the main/production Vercel environment.
# Leave unset or "false" on the develop branch preview.
NEXT_PUBLIC_UNDER_CONSTRUCTION=true

# ─── Stripe (add when ready) ──────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── NFT / Blockchain (add when ready) ────────────────────────────────────────
# NFT_PRIVATE_KEY=...
# NFT_CONTRACT_ADDRESS=...

# ─── Contact form (Resend) — app/api/contact/route.ts ─────────────────────────
# API key from resend.com → API Keys. Server-only.
RESEND_API_KEY=
# Inbox that receives contact form submissions.
CONTACT_EMAIL=
# Sender address. Must be on a domain verified in Resend. Leave empty to use
# Resend's shared onboarding@resend.dev, which only delivers to the email
# address that owns the Resend account.
CONTACT_FROM_EMAIL=
